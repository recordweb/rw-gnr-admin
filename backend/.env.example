# =============================================================================
# rw-gnr-admin backend - environment configuration template
# =============================================================================
# Copy this file to `.env` in admin-app/backend/ and fill in values for YOUR
# organisation's own Fabric identity. Never commit the filled-in `.env` file -
# only this template belongs in git.
#
# This app deliberately holds ONE Fabric identity per running instance
# (option "b" from the rw-gnr-admin design decisions): each organisation on
# the RecordWeb network runs its own deployment of rw-gnr-admin, scoped to
# its own enrolled X.509 identity. There is no login screen and no wallet
# switcher - "who you are" is entirely determined by the certificate/key
# configured here.
# =============================================================================

# --- HTTP server -------------------------------------------------------------
PORT=3000

# --- Fabric network coordinates ----------------------------------------------
# Chaincode name as deployed on the channel(s) (see rw-cc-gnr repo).
CHAINCODE_NAME=rw-cc-gnr

# Channel names. These are network-wide conventions (see rw-rrn Docs/) and
# normally do NOT need to change between organisations.
CHANNEL_NAME_TEST=rw-gnr-test
CHANNEL_NAME_PROD=rw-gnr

# gRPC endpoint of YOUR organisation's gateway peer, and the TLS server name
# (CN/SAN in that peer's TLS certificate) it must be validated against.
PEER_ENDPOINT=peer0.yourorg.rwrrn.recordweb.dev:7051
PEER_HOST_ALIAS=peer0.yourorg.rwrrn.recordweb.dev

# Your organisation's MSP ID (issued by your own Fabric CA).
MSP_ID=YourOrgMSP

# --- Crypto material paths (this organisation's own enrolled identity) ------
# TLS CA certificate used to trust the peer's TLS listener.
PEER_TLS_CA_PATH=/app/crypto/peerOrganizations/yourorg.rwrrn.recordweb.dev/peers/peer0.yourorg.rwrrn.recordweb.dev/tls/ca.crt

# X.509 certificate (signcert) of the identity this instance signs as.
CERT_PATH=/app/crypto/peerOrganizations/yourorg.rwrrn.recordweb.dev/users/Admin@yourorg.rwrrn.recordweb.dev/msp/signcerts/Admin@yourorg.rwrrn.recordweb.dev-cert.pem

# Private key (file or keystore directory - first file found is used).
KEY_PATH=/app/crypto/peerOrganizations/yourorg.rwrrn.recordweb.dev/users/Admin@yourorg.rwrrn.recordweb.dev/msp/keystore

# --- Production write guard --------------------------------------------------
# Safe default: false. Gates WRITES only (RegisterNamespace,
# UpdateResolverEndpoint) against the `prod` network (rw-gnr). Reads
# (ResolveNamespace, GetMyNamespaces, GetNamespaceHistory) are always allowed
# on both networks regardless of this setting.
# Set to `true` only once you are ready to register/update namespaces on the
# production ledger.
ALLOW_PROD_WRITES=false

# --- Static frontend directory ------------------------------------------------
# Defaults to ../frontend relative to backend/src/. Override in Docker images
# where the frontend is copied to a different path (e.g. /app/frontend).
# FRONTEND_DIR=/app/frontend
